<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_confidence_test_age_tree" model="ir.ui.view">
        <field name="name">confidence.test.age.tree</field>
        <field name="model">confidence.test.age</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="age"/>
                <field name="confidence"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_confidence_test_age_form" model="ir.ui.view">
        <field name="name">confidence.test.age.form</field>
        <field name="model">confidence.test.age</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="age"/>
                        <field name="confidence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_confidence_test_age" model="ir.actions.act_window">
        <field name="name">Confidence Test Age</field>
        <field name="res_model">confidence.test.age</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Structure -->
    <menuitem id="menu_confidence_test_root" name="Confidence Testing" sequence="0"/>
    <menuitem id="menu_confidence_test_age"
              name="Test Ages"
              parent="menu_confidence_test_root"
              action="action_confidence_test_age"
              sequence="10"/>
</odoo>
