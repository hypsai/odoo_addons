<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- &#9552;&#9552;&#9552; mcp.base.tool List View &#9552;&#9552;&#9552; -->
    <record id="view_mcp_base_tool_tree" model="ir.ui.view">
        <field name="name">mcp.base.tool.list</field>
        <field name="model">mcp.base.tool</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="active" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="method_id"/>
                <field name="is_code_first"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- &#9552;&#9552;&#9552; mcp.base.tool Form View &#9552;&#9552;&#9552; -->
    <record id="view_mcp_base_tool_form" model="ir.ui.view">
        <field name="name">mcp.base.tool.form</field>
        <field name="model">mcp.base.tool</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Code First" bg_color="bg-info" invisible="not is_code_first"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive" invisible="is_code_first">
                            <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;archive&quot;}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Tool Name"/>
                        <h1><field name="name" placeholder="e.g. Search Customers"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" readonly="is_code_first"/>
                            <field name="method_id" domain="[('model_id', '=', model_id)]" options="{'no_create': True, 'no_open': True}" readonly="is_code_first"/>
                        </group>
                        <group>
                            <field name="is_code_first"/>
                            <field name="active" invisible="is_code_first"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Docstring">
                            <field name="docstring" colspan="2" nolabel="1" placeholder="Write a docstring in Google, NumPy, or Sphinx style to define this tool's parameters and behavior..." readonly="is_code_first"/>
                        </page>
                        <page string="Generated Metadata">
                            <group>
                                <field name="description" colspan="2" nolabel="1"/>
                            </group>
                            <group string="Input Schema">
                                <field name="input_schema" colspan="2" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- &#9552;&#9552;&#9552; Search View &#9552;&#9552;&#9552; -->
    <record id="view_mcp_base_tool_search" model="ir.ui.view">
        <field name="name">mcp.base.tool.search</field>
        <field name="model">mcp.base.tool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <field name="method_id"/>
                <filter string="Code First" name="code_first" domain="[('is_code_first','=',True)]"/>
                <filter string="Config First" name="config_first" domain="[('is_code_first','=',False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- &#9552;&#9552;&#9552; Window Action &#9552;&#9552;&#9552; -->
    <record id="action_mcp_base_tool" model="ir.actions.act_window">
        <field name="name">MCP Tools</field>
        <field name="res_model">mcp.base.tool</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

</odoo>
